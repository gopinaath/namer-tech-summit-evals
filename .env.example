# NAMER Tech Summit — Building an Eval. Credentials for Claude on Amazon Bedrock.
#
#   cp .env.example .env      then fill in the values below.
#
# .env is gitignored. Never paste credentials into a notebook cell.

# ── Option A: Bedrock API key (what most attendees get) ──────────────────────
# Bedrock console -> API keys. Paste the whole value, no quotes, no spaces.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# ── Option B: IAM credentials (SSO, `aws configure`, an assumed role) ────────
# Leave AWS_BEARER_TOKEN_BEDROCK empty, keep AWS_REGION set, and name a profile
# here if you use one. Requires boto3 (installed by `anthropic[bedrock]`).
# AWS_PROFILE=my-profile

# Whichever you use, the credential needs bedrock:InvokeModel, and Claude must be
# enabled for your account in AWS_REGION (Bedrock console -> Model access).
